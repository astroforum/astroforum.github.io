---
layout: default
---
{% comment %}
  Lab-style home page: hero banner, research cards, news, selected papers, contact.
  Replaces the theme's personal "about" layout on the home page only.
{% endcomment %}
{% assign ko = false %}
{% if site.active_lang == 'ko' %}{% assign ko = true %}{% endif %}

<div class="post astro-home">
  <section class="astro-hero">
    <img
      class="astro-hero-logo"
      src="{{ '/assets/img/logo/astro-logo-horizontal-mono-reverse.svg' | relative_url }}"
      alt="ASTRO Lab"
    >
    <p class="astro-hero-tagline">Alloy design for <b>ST</b>ructural <b>RO</b>bustness</p>
    <p class="astro-hero-sub">{{ page.subtitle }}</p>
  </section>

  <article>
    <div class="astro-intro">{{ content }}</div>

    <h2>research</h2>
    <div class="astro-cards">
      {% for area in site.data.research %}
        <div class="astro-card">
          <h3>{% if ko %}{{ area.title_ko }}{% else %}{{ area.title }}{% endif %}</h3>
          <p>{% if ko %}{{ area.desc_ko }}{% else %}{{ area.desc }}{% endif %}</p>
        </div>
      {% endfor %}
    </div>

    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <h2>contact</h2>
    <div class="astro-contact">
      <div>{{ page.contact }}</div>
      {% if page.social %}
        <div class="contact-icons">{% social_links %}</div>
      {% endif %}
    </div>
  </article>
</div>

<style>
  .astro-hero {
    background: #1f2a44;
    color: #fff;
    border-radius: 0.5rem;
    padding: 2.5rem 1.5rem 2rem;
    margin: 1rem 0 2rem;
    text-align: center;
  }
  .astro-hero-logo { width: 100%; max-width: 420px; height: auto; }
  .astro-hero-tagline { font-size: 1.15rem; margin: 1rem 0 0.25rem; letter-spacing: 0.02em; }
  .astro-hero-tagline b { color: #ff6b7d; }
  .astro-hero-sub { opacity: 0.8; margin: 0; font-size: 0.95rem; }
  .astro-intro { margin-bottom: 1.5rem; }
  .astro-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .astro-card {
    border: 1px solid var(--global-divider-color);
    border-top: 4px solid #d7263d;
    border-radius: 0.4rem;
    padding: 1rem 1.1rem;
  }
  .astro-card h3 { font-size: 1.05rem; font-weight: 600; margin: 0 0 0.4rem; }
  .astro-card p { font-size: 0.9rem; margin: 0; color: var(--global-text-color-light); }
  .astro-contact { margin-bottom: 2rem; }
  .astro-contact p { margin-bottom: 0.75rem; }
  .astro-contact .contact-icons { font-size: 1.6rem; }
  @media (max-width: 575.98px) {
    .astro-hero { padding: 1.75rem 1rem 1.5rem; }
    .astro-hero-tagline { font-size: 1rem; }
  }
</style>
