---
layout: default
---
{% comment %}
  Lab-style home page: logo, intro, approach steps, news, selected papers, covers, contact.
  Replaces the theme's personal "about" layout on the home page only.
{% endcomment %}
{% assign ko = false %}
{% if site.active_lang == 'ko' %}{% assign ko = true %}{% endif %}

<div class="post astro-home">
  <section class="astro-hero">
    <img
      class="astro-hero-logo astro-hero-light"
      src="{{ '/assets/img/logo/astro-logo-horizontal-primary.svg' | relative_url }}"
      alt="ASTRO Lab"
    >
    <img
      class="astro-hero-logo astro-hero-dark"
      src="{{ '/assets/img/logo/astro-logo-horizontal-dark.svg' | relative_url }}"
      alt="ASTRO Lab"
    >
    <p class="astro-hero-sub">{{ page.subtitle }}</p>
  </section>

  <article>
    <div class="astro-intro">{{ content }}</div>

    <h2>our approach <span class="astro-h2-sub">fundamentals to applications</span></h2>
    <div class="astro-steps">
      {% for step in site.data.approach %}
        <div class="astro-step">
          <span class="astro-step-num">{{ forloop.index }}</span>
          <h3>{{ step.title }}</h3>
          <p>{% if ko %}{{ step.desc_ko }}{% else %}{{ step.desc }}{% endif %}</p>
        </div>
      {% endfor %}
    </div>
    <p class="astro-more">
      <a href="{{ '/projects/' | relative_url }}">{% if ko %}연구 분야 자세히 보기 →{% else %}Explore our research areas →{% endif %}</a>
    </p>

    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if site.data.covers %}
      <h2>cover articles</h2>
      <div class="astro-covers">
        {% for cover in site.data.covers %}
          <a class="astro-cover" href="https://doi.org/{{ cover.doi }}" target="_blank" rel="noopener">
            <img src="{{ cover.image | prepend: '/assets/img/publication_preview/' | relative_url }}" alt="{{ cover.journal }} cover, {{ cover.issue }}" loading="lazy">
            <span class="astro-cover-journal">{{ cover.journal }}</span>
            <span class="astro-cover-issue">{{ cover.issue }}</span>
            <span class="astro-cover-title">{{ cover.title }}</span>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    <h2>contact</h2>
    <div class="astro-contact">
      <div>{{ page.contact }}</div>
      {% if page.social %}
        <div class="contact-icons">{% social_links %}</div>
      {% endif %}
    </div>
  </article>
</div>

<style>
  .astro-hero {
    padding: 2rem 0 1.75rem;
    margin: 0.5rem 0 2rem;
    border-bottom: 1px solid var(--global-divider-color);
    text-align: center;
  }
  .astro-hero-logo { width: 100%; max-width: 460px; height: auto; }
  .astro-hero-dark { display: none; }
  html[data-theme="dark"] .astro-hero-light { display: none; }
  html[data-theme="dark"] .astro-hero-dark { display: inline; }
  .astro-hero p.astro-hero-sub { color: var(--global-text-color-light); margin: 1rem 0 0; font-size: 1rem; }
  .astro-intro { margin-bottom: 1.5rem; }
  .astro-intro p { font-size: 1.05rem; line-height: 1.7; }
  .astro-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 0.75rem; }
  .astro-step {
    position: relative;
    border: 1px solid var(--global-divider-color);
    border-top: 4px solid #d7263d;
    border-radius: 0.4rem;
    padding: 1rem 1.1rem;
  }
  .astro-step-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.8rem; height: 1.8rem; border-radius: 50%;
    background: #1f2a44; color: #fff; font-weight: 700; font-size: 0.9rem; margin-bottom: 0.5rem;
  }
  html[data-theme="dark"] .astro-step-num { background: #d7263d; }
  .astro-step h3 { font-size: 1.15rem; font-weight: 700; margin: 0 0 0.35rem; }
  .astro-step p { font-size: 0.9rem; margin: 0; color: var(--global-text-color-light); }
  .astro-more { text-align: right; font-weight: 600; margin-bottom: 1rem; }
  .astro-h2-sub { font-size: 1rem; font-weight: 400; color: var(--global-text-color-light); margin-left: 0.5rem; }
  @media (max-width: 767.98px) { .astro-steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 575.98px) { .astro-steps { grid-template-columns: 1fr; } .astro-h2-sub { display: block; margin: 0.25rem 0 0; } }
  .astro-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .astro-card {
    border: 1px solid var(--global-divider-color);
    border-top: 4px solid #d7263d;
    border-radius: 0.4rem;
    padding: 1rem 1.1rem;
  }
  .astro-card h3 { font-size: 1.05rem; font-weight: 600; margin: 0 0 0.4rem; }
  .astro-card p { font-size: 0.9rem; margin: 0; color: var(--global-text-color-light); }
  .astro-home article > h2 { margin-top: 2.5rem; }
  .astro-home .news {
    background: rgba(31, 42, 68, 0.05);
    border-left: 4px solid #1f2a44;
    border-radius: 0.4rem;
    padding: 0.6rem 1rem;
    margin-bottom: 1rem;
  }
  .astro-home .news table { margin: 0; background: transparent; }
  .astro-home .news th[scope="row"] { color: #1f2a44; font-weight: 700; }
  .astro-home .news td, .astro-home .news th { padding-top: 0.45rem; padding-bottom: 0.45rem; background: transparent; }
  html[data-theme="dark"] .astro-home .news { background: rgba(255, 255, 255, 0.06); border-left-color: #8c96a6; }
  html[data-theme="dark"] .astro-home .news th[scope="row"] { color: #c9cfd8; }
  .astro-home .astro-preview { display: none; }
  .astro-covers { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 250px)); gap: 1.5rem; margin-bottom: 1rem; }
  .astro-cover { display: flex; flex-direction: column; color: inherit; text-decoration: none; }
  .astro-cover:hover { color: inherit; text-decoration: none; }
  .astro-cover img { width: 100%; aspect-ratio: 11666 / 16384; object-fit: cover; border-radius: 0.3rem; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18); transition: transform 0.2s, box-shadow 0.2s; }
  .astro-cover:hover img { transform: translateY(-4px); box-shadow: 0 10px 22px rgba(0, 0, 0, 0.25); }
  .astro-cover-journal { margin-top: 0.75rem; font-weight: 700; font-style: italic; }
  .astro-cover-issue { font-size: 0.85rem; color: var(--global-text-color-light); }
  .astro-cover-title { font-size: 0.85rem; margin-top: 0.25rem; line-height: 1.35; }
  @media (max-width: 575.98px) { .astro-covers { grid-template-columns: 1fr 1fr; gap: 1rem; } }
  .astro-contact { margin-bottom: 2rem; }
  .astro-contact p { margin-bottom: 0.75rem; }
  .astro-contact .contact-icons { font-size: 1.6rem; }
  @media (max-width: 575.98px) {
    .astro-hero { padding: 1.25rem 0 1.25rem; }
    .astro-hero p.astro-hero-sub { font-size: 0.85rem; }
  }
</style>
