{% assign ko = false %}
{% if site.active_lang == 'ko' %}{% assign ko = true %}{% endif %}
{% for group in site.data.facility %}
<h2>{% if ko %}{{ group.category_ko }}{% else %}{{ group.category }}{% endif %}</h2>
{% if group.items.size > 0 %}
<div class="astro-equip">
{% for item in group.items %}
<div class="astro-equip-item">
{% if item.image %}
<img src="{{ item.image | prepend: '/assets/img/' | relative_url }}" alt="{{ item.name }}" loading="lazy">
{% else %}
<div class="astro-equip-noimg">{% if item.coming %}<span>{% if ko %}곧 들어옵니다<br>기대해 주세요!{% else %}Coming soon<br>stay tuned!{% endif %}</span>{% endif %}</div>
{% endif %}
<p class="astro-equip-name">{{ item.name }}{% if item.coming %} <span class="astro-equip-badge">{% if ko %}도입 예정{% else %}Coming soon{% endif %}</span>{% endif %}</p>
{% if item.maker %}<p class="astro-equip-maker">{{ item.maker }}</p>{% endif %}
</div>
{% endfor %}
</div>
{% else %}
<p class="astro-equip-empty">{% if ko %}준비 중입니다.{% else %}Coming soon.{% endif %}</p>
{% endif %}
{% endfor %}

<style>
  .astro-equip { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.25rem; margin-bottom: 2rem; }
  .astro-equip-item img, .astro-equip-noimg { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 0.4rem; border: 1px solid var(--global-divider-color); }
  .astro-equip-noimg { background: rgba(31, 42, 68, 0.06); display: flex; align-items: center; justify-content: center; text-align: center; }
  .astro-equip-noimg span { font-weight: 700; color: #1f2a44; line-height: 1.5; }
  html[data-theme="dark"] .astro-equip-noimg { background: rgba(255, 255, 255, 0.06); }
  html[data-theme="dark"] .astro-equip-noimg span { color: #c9cfd8; }
  .astro-equip-badge { display: inline-block; margin-left: 0.25rem; padding: 0.05rem 0.45rem; border-radius: 0.25rem; background: #d7263d; color: #fff; font-size: 0.7rem; font-weight: 700; vertical-align: middle; }
  .astro-equip-name { font-weight: 600; margin: 0.5rem 0 0; font-size: 0.95rem; }
  .astro-equip-maker { margin: 0; font-size: 0.85rem; color: var(--global-text-color-light); }
  .astro-equip-empty { color: var(--global-text-color-light); margin-bottom: 2rem; }
</style>
