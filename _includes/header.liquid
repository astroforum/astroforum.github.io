<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      <!-- Astro Lab: logo + name on every page (overrides al_folio_core header brand) -->
      <a class="navbar-brand title astro-brand" href="{{ site.baseurl }}/">
        <img class="astro-mark astro-mark-light" src="{{ '/assets/img/logo/astro-mark-primary.svg' | relative_url }}" alt="" height="32">
        <img class="astro-mark astro-mark-dark" src="{{ '/assets/img/logo/astro-mark-dark.svg' | relative_url }}" alt="" height="32">
        <span><span class="font-weight-bold">ASTRO</span> Lab</span>
      </a>
      <style>
        .astro-brand { display: inline-flex; align-items: center; gap: 0.5rem; }
        .astro-mark { height: 32px; width: auto; }
        .astro-mark-dark { display: none; }
        html[data-theme="dark"] .astro-mark-light { display: none; }
        html[data-theme="dark"] .astro-mark-dark { display: inline; }
        .astro-lang { display: flex; align-items: center; align-self: center; gap: 0.4rem; padding: 0 0.5rem; }
        .astro-flag { display: inline-flex; line-height: 0; opacity: 0.4; transition: opacity 0.15s; }
        .astro-flag:hover, .astro-flag.active { opacity: 1; }
        .astro-flag img { width: 20px; height: 15px; border-radius: 2px; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15); }
        .news th[scope="row"] { white-space: nowrap; width: 1% !important; padding-right: 1rem; }
        .astro-pi { display: inline-block; vertical-align: middle; margin-left: .4rem; padding: .1rem .5rem; border-radius: .3rem; background: #1f2a44; color: #fff; font-size: .75rem; font-weight: 600; letter-spacing: .05em; }
        html[data-theme="dark"] .astro-pi { background: #d7263d; }
        .astro-cv-btn { display: inline-block; margin-top: .25rem; padding: .4rem 1.2rem; border-radius: .3rem; background: #1f2a44; color: #fff !important; font-weight: 600; text-decoration: none !important; box-shadow: 0 2px 6px rgba(0,0,0,.15); }
        .astro-cv-btn:hover { background: #2e3d61; color: #fff !important; }
        html[data-theme="dark"] .astro-cv-btn { background: #3a4560; }
        html[data-theme="dark"] .astro-cv-btn:hover { background: #4a5878; }
        .astro-preview .preview { width: 100%; }
        @media (max-width: 575.98px) { .astro-preview { display: none; } }
        /* Phone layout */
        @media (max-width: 575.98px) {
          .navbar-collapse-main.show, .navbar-collapse-main.collapsing { background: var(--global-bg-color); padding-bottom: 0.5rem; }
          #navbar { opacity: 1; }
          #navbar:has(.navbar-collapse-main.show) { box-shadow: 0 6px 12px rgba(0, 0, 0, 0.12); }
          .astro-lang { padding: 0.5rem 0; align-self: flex-start; }
          .profile { width: 65% !important; float: none !important; margin: 0 auto 1.5rem !important; }
          .profile .more-info { font-size: 0.8rem; }
        }
      </style>
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="Search" aria-label="Open search">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.languages.size > 1 %}
            <!-- Language switch (jekyll-polyglot): flag icons from flag-icons (MIT) -->
            <li class="nav-item astro-lang">
              {% for tongue in site.languages %}
                {% if tongue == 'ko' %}{% assign flag = 'kr' %}{% assign lang_name = '한국어' %}{% else %}{% assign flag = 'gb' %}{% assign lang_name = 'English' %}{% endif %}
                <a
                  class="astro-flag {% if tongue == site.active_lang %}active{% endif %}"
                  {% static_href %}href="{% if tongue == site.default_lang %}{{ site.baseurl }}{{ page.url }}{% else %}{{ site.baseurl }}/{{ tongue }}{{ page.url }}{% endif %}"{% endstatic_href %}
                  lang="{{ tongue }}"
                  title="{{ lang_name }}"
                  aria-label="{{ lang_name }}"
                ><img src="{{ '/assets/img/flags/' | append: flag | append: '.svg' | relative_url }}" alt="{{ lang_name }}" width="20" height="15"></a>
              {% endfor %}
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
